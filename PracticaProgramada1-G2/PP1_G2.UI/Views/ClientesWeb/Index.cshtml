@model IReadOnlyList<PP1_G2.Application.Dtos.ClienteDto>

@{
	ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1 class="h2 mb-1">Clientes</h1>
		<p class="text-muted mb-0">Listado de clientes registrados y sus teléfonos.</p>
	</div>
	<a asp-action="Create" class="btn btn-primary">Registrar cliente</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@mensaje
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
	</div>
}

@if (Model.Count == 0)
{
	<div class="alert alert-info" role="status">Todavía no hay clientes registrados.</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover align-middle">
			<thead>
				<tr>
					<th>Nombre</th>
					<th>Correo electrónico</th>
					<th>Teléfonos</th>
					<th>Ciudad</th>
					<th class="text-end">Acciones</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var cliente in Model)
				{
					<tr>
						<td>@cliente.Nombre @cliente.Apellido</td>
						<td>@(cliente.Email ?? "—")</td>
						<td>@(cliente.Telefonos.Count > 0 ? string.Join(", ", cliente.Telefonos) : "—")</td>
						<td>@(cliente.Ciudad ?? "—")</td>
						<td class="text-end text-nowrap">
							<a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">Detalle</a>
							<a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
							<a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
