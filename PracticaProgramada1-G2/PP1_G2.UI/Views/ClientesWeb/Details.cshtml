@model PP1_G2.Application.Dtos.ClienteDetalleDto

@{
	ViewData["Title"] = "Detalle del cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="h2 mb-0">Detalle del cliente</h1>
	<div class="d-flex gap-2">
		<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
		<a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
	</div>
</div>

<dl class="row">
	<dt class="col-sm-3">Nombre</dt>
	<dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

	<dt class="col-sm-3">Correo electrónico</dt>
	<dd class="col-sm-9">@(Model.Email ?? "—")</dd>

	<dt class="col-sm-3">Fecha de nacimiento</dt>
	<dd class="col-sm-9">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</dd>

	<dt class="col-sm-3">Ciudad</dt>
	<dd class="col-sm-9">@(Model.Ciudad ?? "—")</dd>

	<dt class="col-sm-3">País</dt>
	<dd class="col-sm-9">@(Model.Pais ?? "—")</dd>

	<dt class="col-sm-3">Teléfonos</dt>
	<dd class="col-sm-9">
		@if (Model.Telefonos.Count == 0)
		{
			<span>—</span>
		}
		else
		{
			<ul class="mb-0">
				@foreach (var telefono in Model.Telefonos)
				{
					<li>@telefono</li>
				}
			</ul>
		}
	</dd>

	<dt class="col-sm-3">Estado</dt>
	<dd class="col-sm-9">@(Model.Activo == 1 ? "Activo" : "Inactivo")</dd>
</dl>
